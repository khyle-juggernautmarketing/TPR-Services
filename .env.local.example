# Public site URL (canonical, sitemap, Open Graph) — set to your Vercel domain in production
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# n8n lead webhook (server-side only — set in Vercel Environment Variables)
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-id
N8N_JWT_SECRET=your-jwt-secret-min-8-chars

# Optional: extra hosts allowed to POST /api/lead (comma-separated)
# ALLOWED_ORIGIN_HOSTS=preview.example.com,staging.example.com

# Optional: Vercel KV / Upstash Redis for shared appointment blocking across instances
# KV_REST_API_URL=https://your-redis.upstash.io
# KV_REST_API_TOKEN=your-token
